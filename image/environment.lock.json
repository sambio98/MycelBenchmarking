{
 "artifact_bytes": 409947210,
 "channels": [
  "conda-forge",
  "bioconda"
 ],
 "description": "The resolved package set of the Phase 1 pinned-tool image, exactly as micromamba installed it. Every entry carries the artifact URL and its sha256, so the image is rebuildable byte-for-byte rather than merely version-matched. A score is comparable only against a run of the same image, and this file is what makes 'the same image' checkable.",
 "not_in_this_image": {
  "antismash": "Needed by L3-1 and L3-5. Not installed here: antiSMASH pulls a large dependency tree plus its ClusterBlast and Pfam databases, and its pin is a pair (binary + database release) that must be resolved together. It is the next image task, not an omission to be filled in silently.",
  "bigscape": "Needed by L3-2, and its pin depends on the antiSMASH and pyhmmer versions, so it follows antiSMASH.",
  "fasttreemp": "Banned. Thread order affects the neighbour-joining heuristic, so it can never be on a gold-producing path.",
  "iqtree": "Not needed by any catalogued template. If it ever is: always --seed, always fixed -T N, never AUTO, and single-gene ML trees are not admissible as gold."
 },
