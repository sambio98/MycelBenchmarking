{"entryType":"UniProtKB reviewed (Swiss-Prot)","primaryAccession":"Q8KHZ8","uniProtkbId":"TRP7H_LENAE","entryAudit":{"firstPublicDate":"2013-05-29","lastAnnotationUpdateDate":"2026-09-02","lastSequenceUpdateDate":"2002-10-01","entryVersion":91,"sequenceVersion":1},"annotationScore":4.0,"organism":{"scientificName":"Lentzea aerocolonigenes","commonName":"Lechevalieria aerocolonigenes","synonyms":["Saccharothrix aerocolonigenes"],"taxonId":68170,"lineage":["Bacteria","Bacillati","Actinomycetota","Actinomycetes","Pseudonocardiales","Pseudonocardiaceae","Lentzea"]},"proteinExistence":"1: Evidence at protein level","proteinDescription":{"recommendedName":{"fullName":{"evidences":[{"evidenceCode":"ECO:0000303","source":"PubMed","id":"17876823"}],"value":"Tryptophan 7-halogenase RebH"},"ecNumbers":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"15743914"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"17260957"}],"value":"1.14.19.9"}]},"alternativeNames":[{"fullName":{"evidences":[{"evidenceCode":"ECO:0000303","source":"PubMed","id":"15743914"}],"value":"FADH(2)-dependent halogenase"}},{"fullName":{"value":"Flavin-dependent tryptophan halogenase RebH"}}]},"genes":[{"geneName":{"value":"rebH"},"synonyms":[{"value":"rbmJ"}]}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"11983340"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"15743914"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"17260957"}],"value":"Involved in the biosynthesis of the indolocarbazole antitumor agent rebeccamycin (PubMed:11983340, PubMed:15743914). Catalyzes the chlorination of tryptophan (Trp) at C7 position to yield 7-chlorotryptophan (PubMed:15743914, PubMed:17260957). It is also able to use bromide ions to generate monobrominated Trp (PubMed:15743914)"}],"commentType":"FUNCTION"},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"L-tryptophan + FADH2 + chloride + O2 = 7-chloro-L-tryptophan + FAD + 2 H2O","reac