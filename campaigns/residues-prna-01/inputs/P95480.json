96"},{"database":"ChEBI","id":"CHEBI:57692"},{"database":"ChEBI","id":"CHEBI:57912"},{"database":"ChEBI","id":"CHEBI:58307"},{"database":"ChEBI","id":"CHEBI:58713"}],"ecNumber":"1.14.19.9","evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"33465708"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"9537395"}]},"physiologicalReactions":[{"directionType":"left-to-right","reactionCrossReference":{"database":"Rhea","id":"RHEA:26495"},"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"9537395"}]}]},{"commentType":"BIOPHYSICOCHEMICAL PROPERTIES","kineticParameters":{"maximumVelocities":[{"velocity":43.0,"unit":"pmol/min/mg","enzyme":"enzyme","evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"18979475"}]}],"michaelisConstants":[{"constant":17.1,"unit":"uM","substrate":"tryptophan (with FAD at pH 7.2 and 30 degrees Celsius)","evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"18979475"}]}]}},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000305","source":"PubMed","id":"9537395"}],"value":"Antibiotic biosynthesis"}],"commentType":"PATHWAY"},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"16195462"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"18979475"}],"value":"Homodimer"}],"commentType":"SUBUNIT"},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"9172332"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"9537395"}],"value":"Cells lacking this gene lose the ability to produce pyrrolnitrin"}],"commentType":"DISRUPTION PHENOTYPE"},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"16195462"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"18979475"}],"value":"The reaction between FADH(2), Cl(-) and O(2) produces hypochlorous acid (HOCl), a powerful oxidant (PubMed:16195462). Unlike the mechanism proposed for the tryptophan 7-halogenase RebH (AC Q8KHZ8), which suggests the formation of a chloramine intermed