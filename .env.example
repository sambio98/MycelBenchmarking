# Copy to .env and fill in the key(s) for the provider you benchmark on.
# biomni-benchmark loads this file automatically (via python-dotenv).

# OpenAI models (--model gpt-4o, gpt-4.1, o3, ...)
OPENAI_API_KEY=

# Anthropic / Claude models (--model claude-sonnet-4-5, claude-opus-..., ...)
ANTHROPIC_API_KEY=

# Optional: other providers Biomni supports
# GEMINI_API_KEY=
# GROQ_API_KEY=
# Azure OpenAI also uses OPENAI_API_KEY plus:
# OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
